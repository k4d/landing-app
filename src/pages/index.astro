---
import { z } from "zod";
import Placeholder from "@/components/Placeholder.astro";
import Layout from "@/layouts/Layout.astro";

const TextMessageSchema = z.object({
  title: z.string(),
  description: z.string(),
});

type TextMessage = z.infer<typeof TextMessageSchema>;

const TEXT_MESSAGE: TextMessage = {
	title: "Hello, Landing App!",
	description: "Build stunning interfaces with Astro, React, Hero UI & Tailwind CSS",
};

TextMessageSchema.parse(TEXT_MESSAGE);
---

<Layout title={TEXT_MESSAGE.title} description={TEXT_MESSAGE.description}>
	<Placeholder title={TEXT_MESSAGE.title} description={TEXT_MESSAGE.description} />
</Layout>
