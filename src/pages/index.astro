---
import { About, Contact, Cta, Docs, Features, Hero, Products } from "@/components/landing";
import Layout from "@/layouts/Layout.astro";

const HeadMeta = {
  title: "Hello, Landing App!",
  description: "Build stunning interfaces with Astro, React, Hero UI & Tailwind CSS",
};

const HeroSection = {
  title: "Build stunning interfaces with modern tools",
  description: "A curated stack of Astro, React, Tailwind CSS, and HeroUI — designed for fast, accessible, and beautiful landing pages.",
};
---

<Layout title={HeadMeta.title} description={HeadMeta.description}>
	<Hero title={HeroSection.title} description={HeroSection.description} client:load />
	<Products client:visible />
	<Features client:visible />
	<About client:visible />
	<Contact client:visible />
	<Docs client:visible />
	<Cta client:visible />
</Layout>
